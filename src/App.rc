#include <windows.h>
#include "resource.h"
1 RT_MANIFEST "app.manifest"
1 VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "LagSwitch for Windows\0"
   VALUE "FileVersion", "1.0.0\0"
   VALUE "ProductName", "LagSwitch\0"
   VALUE "ProductVersion", "1.0.0\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
IDD_SETTINGS DIALOGEX 0, 0, 300, 210
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "LagSwitch Settings"
FONT 9, "Segoe UI"
BEGIN
 CONTROL "Genshin UDP only (recommended)", IDC_GAME_ONLY, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 12, 270, 14
 LTEXT "Unchecked: block system-wide IPv4 and IPv6 traffic.\nLoopback remains available in both modes.", -1, 24, 30, 265, 27
 CONTROL "Automatically restore traffic", IDC_AUTO_RESTORE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 12, 65, 260, 14
 LTEXT "Restore after (minutes):", -1, 24, 87, 120, 12
 EDITTEXT IDC_MINUTES, 154, 84, 69, 16, ES_AUTOHSCROLL | WS_TABSTOP
 LTEXT "Examples: 0.5 = 30 seconds; 2 = 2 minutes", -1, 24, 106, 263, 12
 LTEXT "Toggle shortcut:", -1, 12, 132, 85, 12
 COMBOBOX IDC_SHORTCUT, 101, 129, 187, 65, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
 LTEXT "", IDC_DETECTION, 12, 153, 276, 22
 DEFPUSHBUTTON "Save", IDOK, 176, 184, 54, 16
 PUSHBUTTON "Cancel", IDCANCEL, 236, 184, 52, 16
END
